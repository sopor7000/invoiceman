# Copia este archivo como backend/.env y completa los valores. Nunca subas el .env al repositorio.

# ---- Supabase ----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Sesión ----
# Mínimo 32 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Servidor ----
PORT=4000
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
APP_URL=http://localhost:5173

# ---- Correo (recuperación de contraseña) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
RESET_MINUTOS=30

# ---- Planes y facturación ----
PLAN_GRACIA_DIAS=7
IVA_PCT=19

# ---- Solo en desarrollo (nunca en el VPS) ----
# Ref del proyecto invoiceman-dev. Las siembras y las pruebas que escriben datos
# se niegan a correr si SUPABASE_URL no lo contiene.
DEV_PROJECT_REF=
# Habilita scripts/crear-superadmin-dev.js. Mejor ponerla solo en la sesión de PowerShell.
ALLOW_SEED=
# Habilita npm run test:aislamiento. Mejor ponerla solo en la sesión de PowerShell.
ALLOW_TESTS=
# Backend contra el que corren las pruebas (solo localhost o 127.0.0.1)
TEST_API_URL=http://localhost:4000
